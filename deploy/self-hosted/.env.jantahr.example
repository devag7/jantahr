############
# JantaHR settings, appended to the Supabase .env by ./jantahr.sh setup
############
JANTAHR_WEB_URL=http://localhost:3000
JANTAHR_API_PUBLIC_URL=http://localhost:3002
JANTAHR_WEB_PORT=3000
JANTAHR_API_PORT=3002
# generated by setup: 48-char secrets
JANTAHR_JWT_SECRET=
JANTAHR_ENCRYPTION_KEY=
CRON_SECRET=
JOBS_DISPATCH_SECRET=
# optional
RAZORPAY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
