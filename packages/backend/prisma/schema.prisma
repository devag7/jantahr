enum AppraisalStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  HR_REVIEW
  COMPLETED
  CANCELLED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum SeparationType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  ABSCONDING
  MUTUAL
}

enum ClearanceStatus {
  PENDING
  CLEARED
  NOT_APPLICABLE
}

model AppraisalCycle {
  id         String      @id @default(uuid())
  name       String      @db.VarChar(255)
  companyId  String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  appraisals Appraisal[]
}

model Goal {
  id             String         @id @default(uuid())
  employeeId     String
  companyId      String
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  weightage      Decimal        @default(0) @db.Decimal(5, 2)
  targetValue    String?        @db.VarChar(255)
  achievedValue  String?        @db.VarChar(255)
  startDate      DateTime
  endDate        DateTime
  status         ApprovalStatus @default(PENDING)
  selfRating     Decimal?       @db.Decimal(3, 1)
  managerRating  Decimal?       @db.Decimal(3, 1)
  selfComment    String?        @db.Text
  managerComment String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  employee       Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model Appraisal {
  id                    String          @id @default(uuid())
  employeeId            String
  companyId             String
  appraisalCycleId      String
  reviewerId            String?
  status                AppraisalStatus @default(DRAFT)
  selfRating            Decimal?        @db.Decimal(3, 1)
  managerRating         Decimal?        @db.Decimal(3, 1)
  finalRating           Decimal?        @db.Decimal(3, 1)
  selfComment           String?         @db.Text
  managerComment        String?         @db.Text
  hrComment             String?         @db.Text
  promotionRecommended  Boolean         @default(false)
  salaryRevisionPercent Decimal?        @db.Decimal(5, 2)
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  employee              Employee        @relation(fields: [employeeId], references: [id])
  appraisalCycle        AppraisalCycle  @relation(fields: [appraisalCycleId], references: [id])

  @@unique([employeeId, appraisalCycleId])
  @@index([companyId, status])
}

model OnboardingTemplate {
  id        String                   @id @default(uuid())
  name      String                   @db.VarChar(255)
  companyId String
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  tasks     OnboardingTemplateTask[]
}

model OnboardingTemplateTask {
  id           String             @id @default(uuid())
  templateId   String
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  assignedRole String?            @db.VarChar(50)
  dueInDays    Int                @default(0)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  template     OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model EmployeeOnboarding {
  id          String                   @id @default(uuid())
  employeeId  String
  companyId   String
  templateId  String?
  startDate   DateTime                 @default(now())
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  employee    Employee                 @relation(fields: [employeeId], references: [id])
  tasks       EmployeeOnboardingTask[]

  @@unique([employeeId])
}

model EmployeeOnboardingTask {
  id           String               @id @default(uuid())
  onboardingId String
  title        String               @db.VarChar(255)
  description  String?              @db.Text
  assignedTo   String?
  dueDate      DateTime?
  completedAt  DateTime?
  status       OnboardingTaskStatus @default(PENDING)
  remarks      String?              @db.Text
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  onboarding   EmployeeOnboarding   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
}

model EmployeeSeparation {
  id                     String          @id @default(uuid())
  employeeId             String
  companyId              String
  separationType         SeparationType
  resignationDate        DateTime?
  lastWorkingDate        DateTime?
  noticePeriodDays       Int             @default(30)
  noticePeriodServed     Int?
  shortfallDays          Int?
  exitInterviewDone      Boolean         @default(false)
  exitInterviewNotes     String?         @db.Text
  relievingLetterIssued  Boolean         @default(false)
  experienceLetterIssued Boolean         @default(false)
  status                 ApprovalStatus  @default(PENDING)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  employee               Employee        @relation(fields: [employeeId], references: [id])
  clearances             ExitClearance[]
  fnfSettlement          FnFSettlement?

  @@unique([employeeId])
}

model ExitClearance {
  id           String             @id @default(uuid())
  separationId String
  department   String             @db.VarChar(100)
  clearedBy    String?
  status       ClearanceStatus    @default(PENDING)
  remarks      String?            @db.Text
  clearedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  separation   EmployeeSeparation @relation(fields: [separationId], references: [id], onDelete: Cascade)
}

model FnFSettlement {
  id                    String             @id @default(uuid())
  separationId          String             @unique
  lastSalary            Decimal            @default(0) @db.Decimal(15, 2)
  leaveEncashmentAmount Decimal            @default(0) @db.Decimal(15, 2)
  gratuityAmount        Decimal            @default(0) @db.Decimal(15, 2)
  bonusAmount           Decimal            @default(0) @db.Decimal(15, 2)
  deductions            Decimal            @default(0) @db.Decimal(15, 2)
  recoveries            Decimal            @default(0) @db.Decimal(15, 2)
  netPayable            Decimal            @default(0) @db.Decimal(15, 2)
  status                ApprovalStatus     @default(PENDING)
  processedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  separation            EmployeeSeparation @relation(fields: [separationId], references: [id])
}

// ===================== Phase-2/3 additions =====================

model LwfRate {
