}

// ===================== DPDP Act 2023 — privacy =====================

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  ERASURE
  GRIEVANCE
  NOMINATION
}

enum PrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BreachStatus {
  INVESTIGATING
  CONTAINED
  NOTIFIED
  CLOSED
}

/// Append-only consent ledger: the latest row per (user, purpose) is the current state.
model ConsentRecord {
  id            String   @id @default(uuid())
  companyId     String
  userId        String
  purpose       String   @db.VarChar(60)
  noticeVersion Int
  granted       Boolean
  ipAddress     String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  @@index([userId, purpose, createdAt])
  @@index([companyId])
}

model PrivacyRequest {
  id           String               @id @default(uuid())
  companyId    String
  employeeId   String
  type         PrivacyRequestType
  details      String               @db.Text
  status       PrivacyRequestStatus @default(OPEN)
  resolution   String?              @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  dueDate      DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model DataBreach {
  id                   String         @id @default(uuid())
  companyId            String
  title                String         @db.VarChar(255)
  description          String         @db.Text
  severity             BreachSeverity
  status               BreachStatus   @default(INVESTIGATING)
  occurredAt           DateTime?
  detectedAt           DateTime
  affectedCount        Int?
  dataCategories       String?        @db.VarChar(500)
  containmentActions   String?        @db.Text
  boardNotifiedAt      DateTime?
  principalsNotifiedAt DateTime?
  reportedById         String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([companyId, status])
}

/// HR marks a statutory obligation (ECR, ESI, TDS deposit, return…) as done, with a challan / acknowledgement reference.
model ComplianceFiling {
  id        String   @id @default(uuid())
  companyId String
  key       String   @db.VarChar(60)
  reference String?  @db.VarChar(120)
  filedAt   DateTime @default(now())
  filedById String

  @@unique([companyId, key])
}

// ===================== Cloud edition: plans & billing =====================

enum PlanCode {
  FREE
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  HALTED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// One per company in the cloud edition. The self-hosted edition ignores it (every feature, no seat limit).
model Subscription {
  id                     String             @id @default(uuid())
  companyId              String             @unique
  plan                   PlanCode           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  cycle                  BillingCycle       @default(MONTHLY)
  seats                  Int                @default(0)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// Plan whose features stay readable after the subscription lapsed (data is never locked away)
  lapsedPlan             PlanCode?
  provider               String?            @db.VarChar(20)
  providerSubscriptionId String?            @unique @db.VarChar(64)
  pendingPlan            PlanCode?
  pendingCycle           BillingCycle?
  pendingSeats           Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

/// GST tax invoice for a successful charge. Amounts in paise.
model BillingInvoice {
  id                String       @id @default(uuid())
  companyId         String
  number            String       @unique @db.VarChar(40)
  plan              PlanCode
  cycle             BillingCycle
  seats             Int
  periodStart       DateTime
  periodEnd         DateTime
  taxablePaise      Int
  cgstPaise         Int          @default(0)
  sgstPaise         Int          @default(0)
  igstPaise         Int          @default(0)
  totalPaise        Int
  buyerName         String       @db.VarChar(255)
  buyerGstin        String?      @db.VarChar(20)
  buyerState        String?      @db.VarChar(100)
  provider          String       @db.VarChar(20)
  providerPaymentId String?      @unique @db.VarChar(64)
  issuedAt          DateTime     @default(now())

  @@index([companyId, issuedAt])
}

/// Payment-provider webhook inbox. The id is the provider's event id, so redelivery is a no-op.
model BillingEvent {
  id          String    @id @db.VarChar(80)
  provider    String    @db.VarChar(20)
  type        String    @db.VarChar(80)
  payload     Json
  receivedVia String    @default("api") @db.VarChar(10)
  processedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}
