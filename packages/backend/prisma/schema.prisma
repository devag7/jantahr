datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // native = your machine / Docker build stage; rhel-openssl-3.0.x = Vercel Functions runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  PAYROLL_ADMIN
  MANAGER
  EMPLOYEE
  AUDITOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
  HOLIDAY
}

enum LeaveStatus {
  OPEN
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollFrequency {
  MONTHLY
  BIMONTHLY
  FORTNIGHTLY
  WEEKLY
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum TaxRegime {
  OLD
  NEW
}

enum ShiftStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  GENERATED
  APPROVED
  PAID
  CANCELLED
}

enum LoanType {
  LOAN
  ADVANCE
}

enum LoanStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model User {
  id                 String    @id @default(uuid())
  /// Supabase Auth user id: Supabase holds the password, sessions, email links, Google identity and TOTP factors
  authId             String?   @unique @db.VarChar(64)
  email              String    @unique @db.VarChar(255)
  role               Role
  /// Mirror of "has a verified Supabase TOTP factor"; the auth guard then requires AAL2 sessions
  mfaEnabled         Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  /// Access tokens issued before this instant are rejected (HR reset, deactivation, erasure)
  sessionsRevokedAt  DateTime?
  lastLogin          DateTime?
  companyId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id])
  employee      Employee?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([companyId])
}

model Company {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(255)
  legalName          String    @db.VarChar(255)
  registrationNumber String?   @db.VarChar(100)
  pan                String?   @db.VarChar(20)
  tan                String?   @db.VarChar(20)
  pfNumber           String?   @db.VarChar(50)
  esiNumber          String?   @db.VarChar(50)
  ptRegistration     String?   @db.VarChar(50)
  gstin              String?   @db.VarChar(20)
  address            String?   @db.Text
  city               String?   @db.VarChar(100)
  state              String?   @db.VarChar(100)
  pincode            String?   @db.VarChar(20)
  country            String?   @db.VarChar(100)
  phone              String?   @db.VarChar(20)
  email              String?   @db.VarChar(255)
  website            String?   @db.VarChar(255)
  logo               String?   @db.VarChar(255)
  financialYearStart DateTime?
  basicComponentName String?   @db.VarChar(100)
  hraComponentName   String?   @db.VarChar(100)
  weeklyOffDays      Int[]     @default([0])
  pfEnabled          Boolean   @default(true)
  labourCodeWages    Boolean   @default(true)
  esiEnabled         Boolean   @default(true)
  ptEnabled          Boolean   @default(true)
  lwfEnabled         Boolean   @default(false)
  isMetroCity        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users            User[]
  departments      Department[]
  designations     Designation[]
  employees        Employee[]
  holidayLists     HolidayList[]
  leaveTypes       LeaveType[]
  leavePolicies    LeavePolicy[]
  shiftTypes       ShiftType[]
  salaryComponents SalaryComponent[]
  salaryStructures SalaryStructure[]
  payrollPeriods   PayrollPeriod[]
  payrollEntries   PayrollEntry[]
  shiftLocations   ShiftLocation[]
}

model Department {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(255)
  companyId          String
  parentDepartmentId String?
  headId             String?
  isGroup            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company          Company      @relation(fields: [companyId], references: [id])
  parentDepartment Department?  @relation("DepartmentToDepartment", fields: [parentDepartmentId], references: [id])
  childDepartments Department[] @relation("DepartmentToDepartment")
  employees        Employee[]
}

model Designation {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
}

model Employee {
  id                       String         @id @default(uuid())
  employeeCode             String         @db.VarChar(50)
  userId                   String         @unique
  companyId                String
  departmentId             String?
  designationId            String?
  firstName                String         @db.VarChar(100)
  middleName               String?        @db.VarChar(100)
  lastName                 String         @db.VarChar(100)
  email                    String         @db.VarChar(255)
  personalEmail            String?        @db.VarChar(255)
  phone                    String?        @db.VarChar(20)
  dateOfBirth              DateTime?
  gender                   Gender
  maritalStatus            MaritalStatus
  bloodGroup               String?        @db.VarChar(10)
  nationality              String?        @db.VarChar(50)
  religion                 String?        @db.VarChar(50)
  fatherName               String?        @db.VarChar(100)
  motherName               String?        @db.VarChar(100)
  spouseName               String?        @db.VarChar(100)
  currentAddress           String?        @db.Text
  permanentAddress         String?        @db.Text
  city                     String?        @db.VarChar(100)
  state                    String?        @db.VarChar(100)
  pincode                  String?        @db.VarChar(20)
  emergencyContactName     String?        @db.VarChar(100)
  emergencyContactPhone    String?        @db.VarChar(20)
  emergencyContactRelation String?        @db.VarChar(50)
  dateOfJoining            DateTime
  dateOfConfirmation       DateTime?
  dateOfResignation        DateTime?
  lastWorkingDate          DateTime?
  noticeperiodDays         Int?
  status                   EmployeeStatus
  employmentType           String?        @db.VarChar(50)
  reportingManagerId       String?
  leaveApproverId          String?
  expenseApproverId        String?
  shiftRequestApproverId   String?
  bankName                 String?        @db.VarChar(100)
  bankAccountNumber        String?        @db.Text // Mark for encryption
  ifscCode                 String?        @db.VarChar(20)
  bankBranch               String?        @db.VarChar(100)
  panNumber                String?        @db.Text // Mark for encryption
  aadhaarNumber            String?        @db.Text // Mark for encryption
  uanNumber                String?        @db.VarChar(50)
  esicNumber               String?        @db.VarChar(50)
  pfAccountNumber          String?        @db.VarChar(50)
  professionalTaxState     String?        @db.VarChar(100)
  ctc                      Decimal?       @db.Decimal(15, 2)
  probationEndDate         DateTime?
  profileImage             String?        @db.VarChar(255)
  pfApplicable             Boolean        @default(true)
  esiApplicable            Boolean        @default(true)
  ptApplicable             Boolean        @default(true)
  defaultShiftId           String?
  workLocation             String?        @db.VarChar(100)
  erasedAt                 DateTime?
  anonymizedAt             DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])

  reportingManager Employee?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  reportees        Employee[] @relation("ReportingManager")

  documents                  EmployeeDocument[]
  leaveAllocations           LeaveAllocation[]
  leaveApplications          LeaveApplication[]
  attendances                Attendance[]
  salarySlips                SalarySlip[]
  checkins                   EmployeeCheckin[]
  attendanceRequests         AttendanceRequest[]
  shiftAssignments           ShiftAssignment[]
  leaveLedgerEntries         LeaveLedgerEntry[]
  leaveEncashments           LeaveEncashment[]
  leavePolicyAssignments     LeavePolicyAssignment[]
  taxDeclarations            EmployeeTaxDeclaration[]
  gratuities                 Gratuity[]
  additionalSalaries         AdditionalSalary[]
  salaryStructureAssignments SalaryStructureAssignment[]
  goals                      Goal[]
  appraisals                 Appraisal[]
  onboarding                 EmployeeOnboarding?
  separation                 EmployeeSeparation?
  loans                      EmployeeLoan[]
  expenseClaims              ExpenseClaim[]
  travelRequests             TravelRequest[]
  helpdeskTickets            HelpdeskTicket[]
  compOffRequests            CompensatoryLeaveRequest[]
  policyAcks                 PolicyAcknowledgement[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  documentType String    @db.VarChar(100)
  documentName String    @db.VarChar(255)
  fileUrl      String    @db.VarChar(255)
  expiryDate   DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model HolidayList {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String
  state     String?  @db.VarChar(100)
  year      Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  holidays Holiday[]
}

model Holiday {
  id            String   @id @default(uuid())
  holidayListId String
  name          String   @db.VarChar(255)
  date          DateTime
  isOptional    Boolean  @default(false)
  createdAt     DateTime @default(now())

  holidayList HolidayList @relation(fields: [holidayListId], references: [id])
}

model LeaveType {
  id                   String   @id @default(uuid())
  name                 String   @db.VarChar(100)
  companyId            String
  maxDaysAllowed       Decimal? @db.Decimal(5, 2)
  isCarryForward       Boolean  @default(false)
  maxCarryForwardDays  Decimal? @db.Decimal(5, 2)
  isEncashable         Boolean  @default(false)
  maxEncashableDays    Decimal? @db.Decimal(5, 2)
  isEarnedLeave        Boolean  @default(false)
  earnedLeaveFrequency String?  @db.VarChar(50)
  isLWP                Boolean  @default(false)
  isCompensatory       Boolean  @default(false)
  isOptionalHoliday    Boolean  @default(false)
  includeHolidays      Boolean  @default(false)
  maxContinuousDays    Int?
  applicableGender     Gender?
  sandwichRule         Boolean  @default(false)
  allowNegativeBalance Boolean  @default(false)
  applicableAfterDays  Int?
  isPaid               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id])
  leaveApplications  LeaveApplication[]
  leavePolicyDetails LeavePolicyDetail[]
  leaveAllocations   LeaveAllocation[]
  leaveLedgerEntries LeaveLedgerEntry[]
  leaveEncashments   LeaveEncashment[]
}

model LeavePolicy {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id])
  details     LeavePolicyDetail[]
  assignments LeavePolicyAssignment[]
}

model LeavePolicyDetail {
  id               String   @id @default(uuid())
  leavePolicyId    String
  leaveTypeId      String
  annualAllocation Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id])
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
}

model LeaveAllocation {
  id                   String   @id @default(uuid())
  employeeId           String
  leaveTypeId          String
  companyId            String
  fromDate             DateTime
  toDate               DateTime
  newLeavesAllocated   Decimal  @db.Decimal(5, 2)
  carryForwardedLeaves Decimal  @default(0) @db.Decimal(5, 2)
  totalLeavesAllocated Decimal  @db.Decimal(5, 2)
  usedLeaves           Decimal  @default(0) @db.Decimal(5, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model LeaveApplication {
  id              String      @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  companyId       String
  fromDate        DateTime
  toDate          DateTime
  totalLeaveDays  Decimal     @db.Decimal(5, 2)
  halfDay         Boolean     @default(false)
  halfDayDate     DateTime?
  reason          String?     @db.Text
  status          LeaveStatus @default(OPEN)
  leaveApproverId String?
  approverComment String?     @db.Text
  postingDate     DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, fromDate])
  @@index([companyId, status])
}

model ShiftType {
  id                        String      @id @default(uuid())
  name                      String      @db.VarChar(100)
  companyId                 String
  startTime                 String      @db.VarChar(10)
  endTime                   String      @db.VarChar(10)
  lateEntryGraceMinutes     Int         @default(0)
  earlyExitGraceMinutes     Int         @default(0)
  workingHours              Decimal     @db.Decimal(5, 2)
  halfDayThresholdHours     Decimal     @db.Decimal(5, 2)
  allowCheckInBeforeMinutes Int         @default(0)
  allowCheckOutAfterMinutes Int         @default(0)
  isNightShift              Boolean     @default(false)
  status                    ShiftStatus @default(ACTIVE)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  attendances      Attendance[]
  shiftAssignments ShiftAssignment[]
}

model Attendance {
  id                 String           @id @default(uuid())
  employeeId         String
  companyId          String
  attendanceDate     DateTime
  status             AttendanceStatus
  shiftTypeId        String?
  inTime             DateTime?
  outTime            DateTime?
  workingHours       Decimal?         @db.Decimal(5, 2)
  lateEntry          Boolean          @default(false)
  earlyExit          Boolean          @default(false)
  overtime           Decimal?         @db.Decimal(5, 2)
  leaveTypeId        String?
  leaveApplicationId String?
  remarks            String?          @db.Text
  source             String           @default("MANUAL") @db.VarChar(20)
  inLatitude         Decimal?         @db.Decimal(10, 8)
  inLongitude        Decimal?         @db.Decimal(11, 8)
  selfieUrl          String?          @db.VarChar(255)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  employee  Employee   @relation(fields: [employeeId], references: [id])
  shiftType ShiftType? @relation(fields: [shiftTypeId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([companyId, attendanceDate])
}

model SalaryComponent {
  id                     String              @id @default(uuid())
  name                   String              @db.VarChar(100)
  companyId              String
  type                   SalaryComponentType
  description            String?             @db.Text
  isTaxApplicable        Boolean             @default(true)
  dependsOnPaymentDays   Boolean             @default(true)
  isFlexibleBenefit      Boolean             @default(false)
  isStatutory            Boolean             @default(false)
  statisticalComponent   Boolean             @default(false)
  componentType          String?             @db.VarChar(50)
  formula                String?             @db.Text
  condition              String?             @db.Text
  abbr                   String              @default("") @db.VarChar(30)
  isPfApplicable         Boolean             @default(false)
  isEsiApplicable        Boolean             @default(true)
  isPtApplicable         Boolean             @default(true)
  isEmployerContribution Boolean             @default(false)
  /// Exempt-up-to-a-limit allowance: CHILD_EDUCATION, HOSTEL or MEAL
  exemptionCode          String?             @db.VarChar(30)
  sortOrder              Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company             Company                    @relation(fields: [companyId], references: [id])
  structureComponents SalaryStructureComponent[]
  slipEarnings        SalarySlipEarning[]
  slipDeductions      SalarySlipDeduction[]
  additionalSalaries  AdditionalSalary[]
}

model SalaryStructure {
  id               String           @id @default(uuid())
  name             String           @db.VarChar(100)
  companyId        String
  description      String?          @db.Text
  payrollFrequency PayrollFrequency
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company     Company                     @relation(fields: [companyId], references: [id])
  assignments SalaryStructureAssignment[]
  components  SalaryStructureComponent[]
}

model SalaryStructureComponent {
  id          String   @id @default(uuid())
  structureId String
  componentId String
  amount      Decimal? @db.Decimal(15, 2)
  formula     String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
}

model PayrollPeriod {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  companyId String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model PayrollEntry {
  id                        String           @id @default(uuid())
  companyId                 String
  payrollPeriodId           String
  payrollFrequency          PayrollFrequency
  startDate                 DateTime
  endDate                   DateTime
  departmentId              String?
  branchId                  String?
  month                     Int              @default(1)
  year                      Int              @default(2025)
  status                    PayrollStatus    @default(DRAFT)
  employeeCount             Int              @default(0)
  treatUnmarkedAsLop        Boolean          @default(false)
  totalGross                Decimal?         @db.Decimal(15, 2)
  totalDeductions           Decimal?         @db.Decimal(15, 2)
  totalNet                  Decimal?         @db.Decimal(15, 2)
  totalEmployerContribution Decimal?         @db.Decimal(15, 2)
  processedBy               String?
  processedAt               DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  salarySlips SalarySlip[]

  @@unique([companyId, month, year])
}

// --- Salary Slip & Line Items ---

model SalarySlip {
  id                String        @id @default(uuid())
  employeeId        String
  companyId         String
  payrollEntryId    String?
  postingDate       DateTime      @default(now())
  startDate         DateTime
  endDate           DateTime
  totalWorkingDays  Int
  paymentDays       Decimal       @db.Decimal(5, 2)
  absentDays        Decimal       @default(0) @db.Decimal(5, 2)
  leaveWithoutPay   Decimal       @default(0) @db.Decimal(5, 2)
  grossPay          Decimal       @db.Decimal(15, 2)
  totalEarnings     Decimal       @db.Decimal(15, 2)
  totalDeductions   Decimal       @db.Decimal(15, 2)
  netPay            Decimal       @db.Decimal(15, 2)
  roundedTotal      Decimal       @db.Decimal(15, 2)
  month             Int           @default(1)
  year              Int           @default(2025)
  taxRegime         TaxRegime     @default(NEW)
  pfWages           Decimal       @default(0) @db.Decimal(15, 2)
  pfEmployee        Decimal       @default(0) @db.Decimal(15, 2)
  pfEmployerEpf     Decimal       @default(0) @db.Decimal(15, 2)
  pfEmployerEps     Decimal       @default(0) @db.Decimal(15, 2)
  pfEdli            Decimal       @default(0) @db.Decimal(15, 2)
  pfAdmin           Decimal       @default(0) @db.Decimal(15, 2)
  esiEmployee       Decimal       @default(0) @db.Decimal(15, 2)
  esiEmployer       Decimal       @default(0) @db.Decimal(15, 2)
  professionalTax   Decimal       @default(0) @db.Decimal(15, 2)
  lwfEmployee       Decimal       @default(0) @db.Decimal(15, 2)
  lwfEmployer       Decimal       @default(0) @db.Decimal(15, 2)
  tds               Decimal       @default(0) @db.Decimal(15, 2)
  loanDeduction     Decimal       @default(0) @db.Decimal(15, 2)
  taxableEarnings   Decimal       @default(0) @db.Decimal(15, 2)
  remarks           String?       @db.Text
  gratuityProvision Decimal       @default(0) @db.Decimal(15, 2)
  status            PayrollStatus @default(DRAFT)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  employee     Employee              @relation(fields: [employeeId], references: [id])
  payrollEntry PayrollEntry?         @relation(fields: [payrollEntryId], references: [id])
  earnings     SalarySlipEarning[]
  deductions   SalarySlipDeduction[]

  @@unique([employeeId, year, month])
  @@index([employeeId, startDate])
  @@index([companyId, status])
}

model SalarySlipEarning {
  id                String   @id @default(uuid())
  salarySlipId      String
  salaryComponentId String
  amount            Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @default(now())

  salarySlip      SalarySlip      @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])
}

model SalarySlipDeduction {
  id                String   @id @default(uuid())
  salarySlipId      String
  salaryComponentId String
  amount            Decimal  @db.Decimal(15, 2)
  createdAt         DateTime @default(now())

  salarySlip      SalarySlip      @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])
}

// --- Salary Structure Assignment ---

model SalaryStructureAssignment {
  id                String    @id @default(uuid())
  employeeId        String
  salaryStructureId String
  companyId         String
  fromDate          DateTime
  base              Decimal   @db.Decimal(15, 2) // CTC or base amount for formulas
  variable          Decimal?  @db.Decimal(15, 2)
  taxRegime         TaxRegime @default(NEW)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@unique([employeeId, fromDate])
  @@index([employeeId])
}

// --- Employee Checkin (raw swipe data) ---

model EmployeeCheckin {
  id                 String   @id @default(uuid())
  employeeId         String
  companyId          String
  time               DateTime
  logType            String   @db.VarChar(10) // IN or OUT
  deviceId           String?  @db.VarChar(100)
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  skipAutoAttendance Boolean  @default(false)
  shiftTypeId        String?
  shiftAssignmentId  String?
  source             String   @default("WEB") @db.VarChar(20)
  selfieUrl          String?  @db.VarChar(255)
  ipAddress          String?  @db.VarChar(64)
  processed          Boolean  @default(false)
  createdAt          DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, time])
  @@index([companyId, processed])
}

// --- Attendance Request (regularization) ---

model AttendanceRequest {
  id              String         @id @default(uuid())
  employeeId      String
  companyId       String
  fromDate        DateTime
  toDate          DateTime
  reason          String         @db.Text
  requestType     String         @default("REGULARIZE") @db.VarChar(20)
  status          ApprovalStatus @default(PENDING)
  approverId      String?
  approverComment String?        @db.Text
  halfDay         Boolean        @default(false)
  halfDayDate     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
}

// --- Shift Assignment ---

model ShiftAssignment {
  id          String         @id @default(uuid())
  employeeId  String
  shiftTypeId String
  companyId   String
  startDate   DateTime
  endDate     DateTime?
  status      ApprovalStatus @default(APPROVED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id])

  @@index([employeeId, startDate])
}

// --- Shift Location (for geo-fencing) ---

model ShiftLocation {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(255)
  companyId    String
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  radiusMeters Int      @default(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

// --- Leave Ledger Entry (immutable log) ---

model LeaveLedgerEntry {
  id              String    @id @default(uuid())
  employeeId      String
  leaveTypeId     String
  transactionType String    @db.VarChar(50) // ALLOCATION, LEAVE, CARRY_FORWARD, ENCASHMENT, EXPIRY
  leaves          Decimal   @db.Decimal(5, 2) // positive = credit, negative = debit
  fromDate        DateTime?
  toDate          DateTime?
  isCarryForward  Boolean   @default(false)
  isExpired       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, leaveTypeId])
}

// --- Leave Encashment ---

model LeaveEncashment {
  id               String         @id @default(uuid())
  employeeId       String
  leaveTypeId      String
  leavePeriodFrom  DateTime
  leavePeriodTo    DateTime
  encashableDays   Decimal        @db.Decimal(5, 2)
  encashmentAmount Decimal        @db.Decimal(15, 2)
  status           ApprovalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

// --- Leave Policy Assignment ---

model LeavePolicyAssignment {
  id            String   @id @default(uuid())
  leavePolicyId String
  employeeId    String
  companyId     String
  effectiveFrom DateTime
  assignedById  String?
  createdAt     DateTime @default(now())

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@unique([leavePolicyId, employeeId, effectiveFrom])
}

// --- Tax & Benefits ---

model IncomeTaxSlab {
  id                  String    @id @default(uuid())
  name                String    @db.VarChar(255)
  companyId           String?
  taxRegime           TaxRegime
  effectiveFrom       DateTime
  standardDeduction   Decimal   @db.Decimal(15, 2)
  taxReliefLimit      Decimal?  @db.Decimal(15, 2) // Section 87A income limit
  marginalReliefLimit Decimal?  @db.Decimal(15, 2)
  cessPercent         Decimal   @default(0.04) @db.Decimal(5, 4)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  slabs TaxSlabRow[]
}

model TaxSlabRow {
  id              String   @id @default(uuid())
  incomeTaxSlabId String
  fromAmount      Decimal  @db.Decimal(15, 2)
  toAmount        Decimal  @db.Decimal(15, 2)
  taxPercent      Decimal  @db.Decimal(5, 4)
  createdAt       DateTime @default(now())

  incomeTaxSlab IncomeTaxSlab @relation(fields: [incomeTaxSlabId], references: [id], onDelete: Cascade)
}

model TaxExemptionCategory {
  id        String   @id @default(uuid())
  section   String   @default("") @db.VarChar(20)
  name      String   @db.VarChar(255)
  maxAmount Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())

  subCategories TaxExemptionSubCategory[]
}

model TaxExemptionSubCategory {
  id         String   @id @default(uuid())
  code       String   @default("") @db.VarChar(50)
  name       String   @db.VarChar(255)
  categoryId String
  maxAmount  Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now())

  category     TaxExemptionCategory   @relation(fields: [categoryId], references: [id])
  declarations TaxDeclarationDetail[]
}

model EmployeeTaxDeclaration {
  id                  String         @id @default(uuid())
  employeeId          String
  companyId           String
  payrollPeriodId     String
  taxRegime           TaxRegime
  totalDeclaredAmount Decimal        @default(0) @db.Decimal(15, 2)
  totalHraExemption   Decimal        @default(0) @db.Decimal(15, 2)
  monthlyRent         Decimal        @default(0) @db.Decimal(15, 2)
  rentedInMetro       Boolean        @default(false)
  childrenCount       Int            @default(0)
  homeLoanInterest    Decimal        @default(0) @db.Decimal(15, 2)
  isSubmitted         Boolean        @default(false)
  status              ApprovalStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  employee Employee               @relation(fields: [employeeId], references: [id])
  details  TaxDeclarationDetail[]

  @@unique([employeeId, payrollPeriodId])
}

model TaxDeclarationDetail {
  id             String   @id @default(uuid())
  declarationId  String
  subCategoryId  String
  declaredAmount Decimal  @db.Decimal(15, 2)
  createdAt      DateTime @default(now())

  declaration EmployeeTaxDeclaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  subCategory TaxExemptionSubCategory @relation(fields: [subCategoryId], references: [id])
}

model ProfessionalTaxSlab {
  id              String    @id @default(uuid())
  state           String    @db.VarChar(100)
  fromSalary      Decimal   @db.Decimal(15, 2)
  toSalary        Decimal   @db.Decimal(15, 2)
  taxAmount       Decimal   @db.Decimal(10, 2)
  februaryAmount  Decimal?  @db.Decimal(10, 2)
  gender          String?   @db.VarChar(10)
