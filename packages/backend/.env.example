# --- required ---
DATABASE_URL="postgresql://jantahr:jantahr_dev_2025@localhost:5439/jantahr_dev?schema=public"
# App secret for HMACs (notification channels, upload tickets). Sign-in tokens come from Supabase Auth, not from here.
JWT_SECRET="change-me-to-a-long-random-string"
# AES-256-GCM key for PAN / Aadhaar / bank account encryption. Losing it makes those fields unrecoverable.
ENCRYPTION_KEY="change-me-another-long-random-string"
PORT=3002

# --- web ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- storage (local disk in dev; swap StorageService for S3 in AWS) ---
UPLOAD_DIR=./uploads

# --- email (optional; without SMTP_HOST mails are written to the log) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="JantaHR <no-reply@jantahr.com>"

# --- AI assistant (optional; rule-based answers work without it) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001

# DPDP retention: statutory employee records kept this many years after the last working day; job applicants anonymised after N months
DATA_RETENTION_YEARS=8
APPLICANT_RETENTION_MONTHS=12

# ---- Edition & billing ------------------------------------------------------
# self_hosted (default): every feature, no billing. cloud: plans, seats, Razorpay.
EDITION=self_hosted
# inprocess (Docker/VM) or external (Vercel: Vercel Cron or Supabase pg_cron call /internal/jobs/*)
JOBS_MODE=inprocess
CRON_SECRET=change-me-to-a-long-random-string
# Razorpay (cloud). RAZORPAY_PLAN_IDS maps PLAN_CYCLE to Razorpay plan ids; plan amounts are GST-inclusive.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_IDS={"STANDARD_MONTHLY":"plan_...","STANDARD_ANNUAL":"plan_...","PROFESSIONAL_MONTHLY":"plan_...","PROFESSIONAL_ANNUAL":"plan_..."}
# BILLING_PROVIDER=mock   # development only: activates plans without payment
BILLING_SELLER_NAME=JantaHR
BILLING_SELLER_ADDRESS=
BILLING_SELLER_STATE=Karnataka
BILLING_SELLER_GSTIN=
BILLING_SAC_CODE=997331
PLATFORM_ADMIN_EMAILS=
# EPF ceiling change in Sept 2026: PRO_RATA (default) or NEXT_WAGE_MONTH
PF_CEILING_TRANSITION=PRO_RATA

# ---- Supabase (cloud project or self-hosted stack): REQUIRED -----------------
# Supabase Auth is the only identity provider (passwords, sessions, email links, Google, TOTP). The API needs the
# secret key to create, disable and reset employee sign-ins. Local development without Supabase:
#   GOTRUE_JWT_SECRET=<32+ chars> GOTRUE_SERVICE_KEY=service-local-key pnpm gotrue:stub   (test double on :9999)
#   then SUPABASE_URL=http://localhost:9999 SUPABASE_PUBLISHABLE_KEY=anon-local SUPABASE_SECRET_KEY=service-local-key
#   SUPABASE_JWT_SECRET=<the same 32+ chars>
# DATABASE_URL = transaction pooler (…:6543/postgres?pgbouncer=true&connection_limit=1); DIRECT_URL = session/direct (…:5432) for migrations
# DIRECT_URL=
SUPABASE_URL=
SUPABASE_PUBLIC_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# HS256 projects (self-hosted stack, legacy cloud projects, the local stub): SUPABASE_JWT_SECRET=
# Storage over S3 protocol: STORAGE_DRIVER=s3, S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3, S3_BUCKET=jantahr, AWS_REGION=ap-south-1,
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from Storage > S3 connection, STORAGE_AUTO_CREATE_BUCKET=true
# Uploads: UPLOAD_MODE=direct sends files from the browser straight to the bucket with presigned URLs (default on
# Vercel, whose functions cap request and response bodies at 4.5 MB); UPLOAD_MODE=proxy streams them through the API
# (default elsewhere). S3_PUBLIC_ENDPOINT is the endpoint browsers can reach when S3_ENDPOINT is an internal hostname.
# UPLOAD_MODE=
# S3_PUBLIC_ENDPOINT=
