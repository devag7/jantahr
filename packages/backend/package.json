{
  "name": "jantahr-backend",
  "version": "1.0.0",
  "description": "JantaHR Backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "node test/api-smoke.mjs",
    "migrate:deploy": "node scripts/migrate-deploy.js",
    "vercel-build": "prisma generate && node scripts/migrate-deploy.js && nest build",
    "test:billing": "node test/billing-smoke.mjs",
    "plans:sync": "ts-node scripts/plans-sync.ts",
    "auth:link": "ts-node scripts/auth-link.ts",
    "doctor": "node --env-file=.env scripts/doctor.mjs",
    "gotrue:stub": "node test/support/gotrue-stub.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^5",
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.117.2",
    "bullmq": "^4.14.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.10",
    "express": "^4.19.2",
    "helmet": "^7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6",
    "pdfkit": "^0.14.0",
    "prisma": "^5.7.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "jest": "^29",
    "supertest": "^7.2.2",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
