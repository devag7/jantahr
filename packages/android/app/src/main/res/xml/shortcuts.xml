<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcuts on the launcher icon; the same three as the web app manifest. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="checkin" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_checkin" android:shortcutLongLabel="@string/shortcut_checkin_long">
        <intent android:action="android.intent.action.MAIN" android:targetPackage="com.devshipit.jantahr"
            android:targetClass="com.devshipit.jantahr.LauncherActivity" android:data="https://jantahr.devshipit.com/me/attendance?source=android-app" />
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
    <shortcut android:shortcutId="leave" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_leave" android:shortcutLongLabel="@string/shortcut_leave_long">
        <intent android:action="android.intent.action.MAIN" android:targetPackage="com.devshipit.jantahr"
            android:targetClass="com.devshipit.jantahr.LauncherActivity" android:data="https://jantahr.devshipit.com/me/leave?source=android-app" />
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
    <shortcut android:shortcutId="payslips" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_payslips" android:shortcutLongLabel="@string/shortcut_payslips_long">
        <intent android:action="android.intent.action.MAIN" android:targetPackage="com.devshipit.jantahr"
            android:targetClass="com.devshipit.jantahr.LauncherActivity" android:data="https://jantahr.devshipit.com/me/payslips?source=android-app" />
        <categories android:name="android.intent.category.LAUNCHER" />
    </shortcut>
</shortcuts>
